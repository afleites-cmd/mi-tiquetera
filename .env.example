# URL de PostgreSQL (Supabase / Neon / local)
DATABASE_URL="postgresql://usuario:password@host:5432/mi_tiquetera?schema=public"

# Opcional: conexión directa (sin "-pooler") para migraciones. Si falta, se deriva sola.
# DIRECT_URL="postgresql://usuario:password@host:5432/mi_tiquetera?schema=public"

# Clave para firmar sesiones. Generar con: openssl rand -base64 32
AUTH_SECRET="cambiar-por-una-clave-larga-y-aleatoria"


# Adjuntos en Vercel Blob (lo crea Vercel al conectar un Blob store). En local es opcional.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
