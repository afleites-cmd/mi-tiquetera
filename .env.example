# URL de PostgreSQL (Supabase / Neon / local)
DATABASE_URL="postgresql://usuario:password@host:5432/mi_tiquetera?schema=public"

# Clave para firmar sesiones. Generar con: openssl rand -base64 32
AUTH_SECRET="cambiar-por-una-clave-larga-y-aleatoria"

# Necesario en Vercel (sin barra final). En local se puede omitir.
# AUTH_URL="https://mi-tiquetera.vercel.app"
AUTH_TRUST_HOST=true
